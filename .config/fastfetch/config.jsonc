{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "fedora",
    "padding": {
      "right": 4
    }
  },

  "display": {
    "separator": " ➜ "
  },

  "modules": [
    "break",

    {
      "type": "title",
      "color": {
        "user": "blue",
        "at": "white",
        "host": "cyan"
      }
    },

    {
      "type": "separator",
      "string": "────────────────────────────────────────"
    },

    {
      "type": "os",
      "key": " OS"
    },
    {
      "type": "host",
      "key": "󰌢 Host"
    },
    {
      "type": "kernel",
      "key": "󰍛 Kernel"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime"
    },
    {
      "type": "packages",
      "key": "󰏖 Packages"
    },

    "break",

    {
      "type": "shell",
      "key": " Shell"
    },
    {
      "type": "terminal",
      "key": " Terminal"
    },
    {
      "type": "wm",
      "key": " WM"
    },
    {
      "type": "theme",
      "key": "󰧨 Theme"
    },
    {
      "type": "icons",
      "key": "󰉋 Icons"
    },
    {
      "type": "cursor",
      "key": "󰇄 Cursor"
    },

    "break",

    {
      "type": "cpu",
      "key": " CPU"
    },
    {
      "type": "gpu",
      "key": "󰢮 GPU"
    },
    {
      "type": "memory",
      "key": "󰾆 Memory",
      "percent": {
        "type": 9
      }
    },
    {
      "type": "disk",
      "key": " Disk",
      "folders": [
        "/"
      ]
    },

    "break",

    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "●"
    }
  ]
}
